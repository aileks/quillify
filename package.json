    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.561.0",
    "mailtrap": "^4.8.0",
    "next": "^16.3.1",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
